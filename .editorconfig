# Padronização de editor para toda a equipe (IntelliJ, VS Code e outros respeitam este arquivo).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{html,css,js}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[mvnw]
end_of_line = lf

[*.cmd]
end_of_line = crlf
